datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int        @id
  name     String
  role     String     // "instrutor" ou "aluno"
  rooms    ChatRoom[] @relation("ChatUsers")
  messages Message[]
}

model ChatRoom {
  id       Int       @id @default(autoincrement())
  title    String?
  users    User[]    @relation("ChatUsers")
  messages Message[]
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  room      ChatRoom @relation(fields: [roomId], references: [id])
  roomId    Int
}